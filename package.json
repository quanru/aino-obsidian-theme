{
  "name": "@lifeos/aino-obsidian-theme",
  "version": "1.0.8",
  "private": true,
  "description": "A warm, focused theme for Obsidian with complete light and dark modes.",
  "scripts": {
    "build": "node scripts/build-theme.mjs --write",
    "check": "node scripts/check-theme.mjs && node scripts/check-release-notes.mjs && stylelint \"theme.css\" \"src/*.css\"",
    "lint": "stylelint \"theme.css\"",
    "version": "node scripts/version-bump.mjs"
  },
  "devDependencies": {
    "stylelint": "^17.14.1",
    "stylelint-config-obsidianmd": "^0.1.0"
  }
}
